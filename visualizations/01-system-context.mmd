%% 01-system-context.mmd
%% Three MCP servers, one shared SQLite DB, the Polling Server, and the three remotes.
%% Claude Code is a "code_" partner with exactly one legal counterpart: a
%% bridge-scientist Claude Science session. The cardinality runs the OTHER way --
%% a bridge-scientist holds at most one code_ partner; nothing stops one code_
%% partner handshaking bridges in two different science projects.
flowchart TB

    subgraph AGENTS["Calling agents (MCP clients)"]
        NLMAGENT["Agent talking to\nNotebookLM notebooks"]
        SCIAGENT["Agent talking to\nClaude Science partners"]
        GEMAGENT["Agent talking to\nAntigravity partners"]
        CODE["Claude Code\n(a 'code_' partner, local, no adapter\nand no server of its own -- it acts as\na requester against the science server)"]
    end

    subgraph SERVERS["MCP servers -- one FastMCP process per adapter"]
        MCPNLM["messaging-nlm\nMCP server\n(embeds MessagingCore\n+ its OWN PollingServer)"]
        MCPSCI["messaging-science\nMCP server\n(embeds MessagingCore\n+ its OWN PollingServer)"]
        MCPGEM["messaging-gemini\nMCP server\n(embeds MessagingCore\n+ its OWN PollingServer)"]
    end

    DB[("shared SQLite database\n(schema/schema.sql, WAL mode)")]

    POLL["Polling Server -- NOT a shared process.\nOne instance INSIDE each MCP server above,\nholding exactly ONE extension: its own source.\nIt declines to drain any partner of another source.\n\nOne drain thread per Partner (advances the queue,\nwaits on the remote, reports back), plus ONE\nsupervisor thread scanning for partners of its own\nsources that have work and no live thread."]

    NLMREMOTE{{"NotebookLM\n(nlm_ CLI)"}}
    SCIREMOTE{{"Claude Science\n(science_ HTTP API)"}}
    GEMREMOTE{{"Antigravity\n(gemini_ tmux)"}}

    NLMAGENT -->|"MCP tool calls\n(create_partner, send, read, ...)"| MCPNLM
    SCIAGENT -->|"MCP tool calls\n(create_partner, send, read, ...)"| MCPSCI
    GEMAGENT -->|"MCP tool calls\n(create_partner, send, read, ...)"| MCPGEM
    CODE -->|"handshakes a bridge-scientist,\nthen sends"| MCPSCI

    MCPNLM -->|"reads/writes via\nMessagingCore"| DB
    MCPSCI -->|"reads/writes via\nMessagingCore"| DB
    MCPGEM -->|"reads/writes via\nMessagingCore"| DB

    POLL -->|"advances message_queue,\nreports back into the Caller's,\nregisters drain_threads"| DB

    POLL -->|"deliver_message /\npoll_completion /\nread_remote_result"| NLMREMOTE
    POLL -->|"deliver_message /\nstop_remote_execution /\npoll_completion /\nread_remote_result"| SCIREMOTE
    POLL -->|"deliver_message / stop /\npoll_completion /\nread_remote_result"| GEMREMOTE

    MCPNLM -.->|"verify_* on create,\ndeliver_message via send"| NLMREMOTE
    MCPSCI -.->|"verify_* on create, deliver_message\nvia send, stop_remote_execution on a\ndisplacement AND on a blocking sender"| SCIREMOTE
    MCPGEM -.->|"verify_* on create, deliver_message via send,\nget + add + delete_permissions -- these three are\ncalled by MessagingCore in THIS process, never by\nthe Polling Server"| GEMREMOTE

    MCPNLM -.->|"notify_partner_push"| POLL
    MCPSCI -.->|"notify_partner_push"| POLL
    MCPGEM -.->|"notify_partner_push"| POLL

    ARM["A push is only ONE of the ways a drain thread is armed,\nand not the usual one: send arms its target directly\n(best-effort), a completion arms the Caller it replied to,\nand the supervisor arms everything else on an interval.\nThat last one is what closes the cross-process gap."]
    POLL -.-> ARM
