%% 07-handshake-legality.mmd
%% Decision tree for MessagingCore.handshake(requester -> target). Order follows core.py.
flowchart TD
    START(["handshake(requester, target)"])

    SELF{"requester == target?"}
    START --> SELF
    SELF -->|yes| R_SELF["Rejected: self_handshake"]

    TGTNLM{"target's source is nlm_?"}
    SELF -->|no| TGTNLM
    TGTNLM -->|yes| R_NLM["Rejected: handshake_not_needed\nnlm_ needs NO handshake --\nmessage it directly"]

    CODEEITHER{"is either side code_?"}
    TGTNLM -->|no| CODEEITHER

    CODEEITHER -->|yes| CODEBRIDGE{"is the OTHER side a science_\nbridge-scientist?"}
    CODEBRIDGE -->|no| R_CODE["Rejected: code_handshakes_bridge_only\nClaude code has exactly one\nlegal counterpart"]
    CODEBRIDGE -->|yes| CODESINGLE{"does that bridge already hold\na DIFFERENT code_ handshake?"}
    CODESINGLE -->|yes| R_CODESINGLE["Rejected: bridge_single_code_partner\ntwo would make 'the Caller'\nambiguous for every message"]
    CODESINGLE -->|no| OK_CODE(["Handshake created.\nNote: no orchestrator role was\nrequired -- code_ holds none,\nand that exemption is why this\nbranch comes first"])

    REQORCH{"requester has an\norchestrator_type?"}
    CODEEITHER -->|no| REQORCH
    REQORCH -->|no| R_NOORCH["Rejected: requester_not_orchestrator"]

    SAMESRC{"same source on both sides,\nAND different Project?"}
    REQORCH -->|yes| SAMESRC

    SAMESRC -->|yes| EXTLINK{"is there a project_extension\nrow linking the two?"}
    EXTLINK -->|no| R_PROJ["Rejected: different_project"]
    EXTLINK -->|yes| SAMEROLE{"do BOTH hold the SAME\norchestrator role?"}
    SAMEROLE -->|no| R_ROLE["Rejected: cross_project_requires_same_role\nan extension branches an effort sideways.\nIt is not a second chain of command, so a\ngemini-orchestrator cannot inherit from a\nproject-orchestrator across one"]
    SAMEROLE -->|yes| OK_EXT(["Handshake created.\nThe role-pair rules below are about\nwho directs whom inside ONE Project\nand say nothing about two peers.\nGrants NOTHING within one Project --\nthose ids are equal, so this branch\nis unreachable for them"])

    DUP{"a handshake already exists\nrequester -> target?"}
    SAMESRC -->|no| DUP
    DUP -->|yes| R_DUP["Rejected: duplicate_handshake"]

    PAIR{"what pair of sources?"}
    DUP -->|no| PAIR

    PAIR -->|"gemini_ -> gemini_"| R_GG["Rejected: no_handshake_between_gemini"]
    PAIR -->|"gemini_ -> science_"| R_GS["Rejected: gemini_to_science_illegal"]

    PAIR -->|"science_ -> science_"| ISBRIDGE{"is the requester a\nbridge-scientist?"}
    ISBRIDGE -->|yes| BRIDGETGT{"is the target the\nproject-orchestrator?"}
    BRIDGETGT -->|no| R_BRIDGE["Rejected: bridge_handshakes_orchestrator_or_code\nthe bridge hands work down to the\nproject-orchestrator and takes it back.\nIt wires up nothing else"]
    BRIDGETGT -->|yes| OK_BRIDGE(["Handshake created"])
    ISBRIDGE -->|no| SCIORCH{"requester is the\nproject-orchestrator?"}
    SCIORCH -->|no| R_SCIORCH["Rejected: requires_project_orchestrator"]
    SCIORCH -->|yes| OK_SS(["Handshake created"])

    PAIR -->|"science_ -> gemini_\n(cross-Project by construction)"| GEMORCH{"requester is the\ngemini-orchestrator?"}
    GEMORCH -->|no| R_GEMORCH["Rejected: requires_gemini_orchestrator"]
    GEMORCH -->|yes| SINGLEMASTER{"is this gemini_ target already\nhandshaken from a DIFFERENT\nscience_ partner?"}
    SINGLEMASTER -->|yes| R_SINGLE["Rejected: gemini_single_science_source\na gemini_ partner serves\nonly ONE science_ master"]
    SINGLEMASTER -->|no| BUDGETGRANT{"does requester hold a\nbudget_grants row?"}
    BUDGETGRANT -->|no| R_NOBUDGET["Rejected: no_gemini_budget"]
    BUDGETGRANT -->|yes| BUDGETUSED{"used gemini_ handshakes\n>= budget_count?"}
    BUDGETUSED -->|yes| R_BUDGET["Rejected: gemini_budget_exceeded"]
    BUDGETUSED -->|no| OK_SG(["Handshake created"])
