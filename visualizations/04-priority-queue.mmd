%% 04-priority-queue.mmd
%% One queue per Partner, ordered by priority. Every message is a push; there is no
%% reply channel and so no routing decision to get wrong.
flowchart LR

    SENDER["Caller calls send(...)\nwith a behavior label\n(no direction, no role)"]

    subgraph ADMIT["Admission -- ONE statement, so a race cannot pass it twice"]
        direction TB
        CAP{{"label_caps.max_outstanding\nfor (caller_id, behavior)\nIS NULL?"}}
        COUNT["COUNT(queued for this\ncaller + this label)\n+ 1 if the WORKING SLOT\nholds one more of the same"]
        REJECT["Rejected('over_queue')\nnothing queued, nothing stored"]
        CAP -->|"NULL -- uncapped"| OK["admitted"]
        CAP -->|"3 for [QUERY]\n2 for [RESEARCH]"| COUNT
        COUNT -->|"under cap"| OK
        COUNT -->|"at cap"| REJECT
    end

    SENDER --> CAP

    BLOCK{{"is it a REQUEST?\n[RESEARCH] [ERROR] [QUERY]\n(labels.REQUEST_BEHAVIORS)"}}
    SENDER --> BLOCK
    BLOCK -->|no| NOSTOP["the sender keeps working"]
    BLOCK -->|yes| AWAIT["interrupt(): stop the SENDER's remote,\nrequeue ITS working task paused,\nEMPTY its slot, set partners.interrupted,\nand stop + deregister its drain thread\n\nNothing takes the slot. The recipient is\nnot disturbed at all."]
    AWAIT --> SLOT

    Q[("message_queue -- ONE per Partner\n\nreading the head is TWO questions:\n1. which LABEL -- priority, then a label with\n   unpaused work over one entirely paused, then\n   earliest FRESH arrival, then earliest arrival\n2. which ROW of it -- paused first, then\n   arrival, then row id")]
    OK --> Q

    PRIO["label_caps.priority -- lower wins\n\n1  [TRUTHFUL-REPORT]    summarize without contamination\n2  [QUERY] = [ERROR]    both stop the SENDER; an unanswered\n                     question is the blocker\n3  [MESSAGE-RESPONSE]   the answer that unblocks\n4  [RESEARCH]           delegated work, the patient kind"]

    Q -.->|"ordered by"| PRIO

    SLOT["WORKING SLOT\nin memory, never in SQLite\n(messaging_core/slots.py)"]
    Q -->|"advance(): promoted"| SLOT
    SLOT -->|"displaced: pushed back"| Q

    SWAP["THE SWAP, both directions.\n\nPromoted when the slot is EMPTY, or when the head\nSTRICTLY beats the working task.\n\nDisplaced with in_process=1, carrying summary_phase\nand origin_behavior -- a marker dropped here is a\nfact nothing downstream can reconstruct."]
    SLOT -.-> SWAP

    TIE["in_process is a tie-break WITHIN one label,\nnot a global override -- which is why the head\nneeds two statements, not one ORDER BY.\n\n[QUERY] and [ERROR] SHARE a priority. While the\ntie-break was global, a paused [QUERY] beat a fresh\n[ERROR], and the Caller's correction was never\ndelivered to the Partner it was correcting."]
    Q -.-> TIE

    ANSWER["While partners.interrupted is set, advance promotes\nONLY a FRESH response, selected BY LABEL.\n\nBy label, because a response need not outrank what is\nqueued -- [MESSAGE-RESPONSE] is 2, so an agent holding\na [TRUTHFUL-REPORT] has a head that is NEVER the answer,\nand a head read would return None forever.\n\nFRESH, because interrupting pushes the agent OWN task\nback -- if that task was a response, accepting a paused\none would make interrupting self-undoing."]
    SLOT -.-> ANSWER

    EQ["EQUAL priority does NOT displace.\nAn arriving [QUERY] never interrupts\na [QUERY] being answered, or two callers\nping-pong a partner and neither is answered."]
    SLOT -.-> EQ

    STORE[("messages\nonly labels with\nlabel_caps.stored = 1:\n[QUERY] [TRUTHFUL-REPORT]\n[MESSAGE-RESPONSE]")]
    OK -.->|"[RESEARCH] and [ERROR]\nare transport -- never written"| STORE
